{
  "name": "@mock-stack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../../packages/application/dist src/server.ts",
    "build": "pnpm --filter @mock-stack/application run build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:build": "docker build -f Dockerfile -t mock-stack-api ../.."
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "@mock-stack/application": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "kysely": "^0.28.16",
    "pg": "^8.20.0",
    "redis": "^5.10.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
