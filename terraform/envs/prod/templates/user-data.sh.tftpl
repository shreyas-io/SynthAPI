#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y awscli nginx docker python3 openssl

if ! swapon --show | grep -q '/swapfile'; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi

if ! grep -q '^/swapfile ' /etc/fstab; then
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

systemctl enable --now docker

mkdir -p /opt/synthapi/bin
mkdir -p /etc/synthapi/certs
mkdir -p /etc/systemd/system

cat >/etc/nginx/conf.d/synthapi.conf <<'NGINX'
${nginx_config}
NGINX

cat >/etc/systemd/system/synthapi-api.service <<'APIUNIT'
${api_service_unit}
APIUNIT

cat >/etc/systemd/system/synthapi-cert-renew.service <<'CERTSERVICE'
${cert_renew_service_unit}
CERTSERVICE

cat >/etc/systemd/system/synthapi-cert-renew.timer <<'CERTTIMER'
${cert_renew_timer_unit}
CERTTIMER

cat >/opt/synthapi/bin/render-api-env.sh <<'EOF'
#!/bin/bash
set -euo pipefail

secret_json="$(aws secretsmanager get-secret-value \
  --region ${region} \
  --secret-id ${bootstrap_secret_arn} \
  --version-stage ${bootstrap_secret_stage} \
  --query SecretString \
  --output text)"

python3 - "$secret_json" <<'PY' >/opt/synthapi/api.env
import json
import sys

allowed = [
    "USE_VAULT_SECRETS",
    "INFISICAL_SITE_URL",
    "INFISICAL_ENVIRONMENT",
    "INFISICAL_PROJECT_ID",
    "INFISICAL_SECRET_PATH",
    "INFISICAL_CLIENT_ID",
    "INFISICAL_CLIENT_SECRET",
]

payload = json.loads(sys.argv[1])
if "VAULT_INIT" in payload:
    payload = json.loads(payload["VAULT_INIT"])

for key in allowed:
    value = payload.get(key)
    if value is None:
        raise SystemExit(f"missing bootstrap secret key: {key}")
    print(f"{key}={value}")
PY

cat >>/opt/synthapi/api.env <<'APPENV'
HOST=0.0.0.0
PORT=3001
APPENV

chmod 600 /opt/synthapi/api.env
EOF

cat >/opt/synthapi/bin/pull-api-image.sh <<'EOF'
#!/bin/bash
set -euo pipefail

aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_registry}
docker pull ${api_image}
EOF

cat >/opt/synthapi/bin/associate-eip.sh <<'EOF'
#!/bin/bash
set -euo pipefail

token="$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
instance_id="$(curl -sH "X-aws-ec2-metadata-token: $${token}" http://169.254.169.254/latest/meta-data/instance-id)"

aws ec2 associate-address \
  --region ${region} \
  --allocation-id ${eip_allocation_id} \
  --instance-id "$${instance_id}" \
  --allow-reassociation
EOF

cat >/opt/synthapi/bin/ensure-certs.sh <<'EOF'
#!/bin/bash
set -euo pipefail

cert_dir="/etc/synthapi/certs"
cert_path="$${cert_dir}/origin.crt"
key_path="$${cert_dir}/origin.key"
desired_wildcard="*.${domain_name}"
renew_window_seconds=$((30 * 24 * 60 * 60))

mkdir -p "$cert_dir"
chmod 700 "$cert_dir"

if [[ -f "$cert_path" && -f "$key_path" ]]; then
  cert_sans="$(openssl x509 -in "$cert_path" -noout -ext subjectAltName 2>/dev/null || true)"

  if grep -Fq "DNS:${api_domain}" <<<"$cert_sans" \
    && grep -Fq "DNS:$desired_wildcard" <<<"$cert_sans" \
    && openssl x509 -checkend "$renew_window_seconds" -noout -in "$cert_path" >/dev/null 2>&1; then
    exit 0
  fi
fi

secret_json="$(aws secretsmanager get-secret-value \
  --region ${region} \
  --secret-id ${bootstrap_secret_arn} \
  --version-stage ${bootstrap_secret_stage} \
  --query SecretString \
  --output text)"

cf_api_token="$(python3 - "$secret_json" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
if "VAULT_INIT" in payload:
    payload = json.loads(payload["VAULT_INIT"])

token = payload.get("CLOUDFLARE_API_TOKEN")
if not token:
    raise SystemExit("missing bootstrap secret key: CLOUDFLARE_API_TOKEN")

print(token)
PY
)"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

openssl genrsa -out "$tmpdir/origin.key" 2048
openssl req \
  -new \
  -sha256 \
  -key "$tmpdir/origin.key" \
  -subj "/CN=${api_domain}" \
  -out "$tmpdir/origin.csr"

python3 - "$tmpdir/origin.csr" "${api_domain}" "${domain_name}" <<'PY' >"$tmpdir/request.json"
import json
import sys
from pathlib import Path

csr = Path(sys.argv[1]).read_text()
api_domain = sys.argv[2]
domain_name = sys.argv[3]

json.dump(
    {
        "csr": csr,
        "hostnames": [api_domain, f"*.{domain_name}"],
        "request_type": "origin-rsa",
        "requested_validity": 5475,
    },
    sys.stdout,
)
PY

http_code="$(curl -sS \
  -o "$tmpdir/response.json" \
  -w "%%{http_code}" \
  "https://api.cloudflare.com/client/v4/certificates" \
  -H "Authorization: Bearer $cf_api_token" \
  -H "Content-Type: application/json" \
  --data-binary @"$tmpdir/request.json")"

python3 - "$tmpdir/response.json" "$tmpdir/origin.crt" "$http_code" <<'PY'
import json
import sys
from pathlib import Path

response_path = Path(sys.argv[1])
cert_path = Path(sys.argv[2])
http_code = sys.argv[3]
payload = json.loads(response_path.read_text())

if http_code != "200" or not payload.get("success"):
    errors = payload.get("errors") or payload.get("messages") or [{"message": "unknown Cloudflare Origin CA error"}]
    formatted = "; ".join(str(item.get("message", item)) for item in errors)
    raise SystemExit(f"Cloudflare Origin CA request failed ({http_code}): {formatted}")

certificate = payload.get("result", {}).get("certificate")
if not certificate:
    raise SystemExit("Cloudflare Origin CA response did not include a certificate")

cert_path.write_text(certificate)
PY

install -m 600 "$tmpdir/origin.key" "$key_path"
install -m 600 "$tmpdir/origin.crt" "$cert_path"

if systemctl is-active --quiet nginx; then
  systemctl reload nginx
fi
EOF

chmod +x /opt/synthapi/bin/render-api-env.sh
chmod +x /opt/synthapi/bin/pull-api-image.sh
chmod +x /opt/synthapi/bin/associate-eip.sh
chmod +x /opt/synthapi/bin/ensure-certs.sh

/opt/synthapi/bin/associate-eip.sh
/opt/synthapi/bin/pull-api-image.sh
/opt/synthapi/bin/ensure-certs.sh

nginx -t

systemctl daemon-reload
systemctl enable --now synthapi-api.service
systemctl enable --now nginx
systemctl enable --now synthapi-cert-renew.timer
