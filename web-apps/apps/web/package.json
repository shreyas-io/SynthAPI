{
  "name": "@synthapi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --config vite.dev.config.ts --host 0.0.0.0 --port 5173",
    "build": "XDG_CONFIG_HOME=../../.wrangler-state vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "preview": "XDG_CONFIG_HOME=../../.wrangler-state vite preview --host 127.0.0.1 --port 4173",
    "deploy": "pnpm run build && XDG_CONFIG_HOME=../../.wrangler-state wrangler deploy"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.15.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.35.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wrangler": "4.87.0"
  }
}
