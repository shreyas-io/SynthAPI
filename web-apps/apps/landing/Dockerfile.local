FROM node:22-alpine

WORKDIR /repo/web-apps

RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

COPY web-apps/package.json web-apps/pnpm-lock.yaml web-apps/pnpm-workspace.yaml web-apps/tsconfig.base.json ./
COPY web-apps/apps/landing/package.json apps/landing/package.json

RUN pnpm install --frozen-lockfile --filter @synthapi/landing...

EXPOSE 5174

CMD ["pnpm", "--filter", "@synthapi/landing", "run", "dev"]
