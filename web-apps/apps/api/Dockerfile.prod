FROM node:22-bookworm-slim AS builder

WORKDIR /repo/web-apps

RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

COPY web-apps/package.json web-apps/pnpm-lock.yaml web-apps/pnpm-workspace.yaml web-apps/tsconfig.base.json ./
COPY web-apps/apps/api/package.json apps/api/package.json

RUN pnpm install --frozen-lockfile --filter @synthapi/api...

COPY web-apps/apps/api apps/api

RUN pnpm --filter @synthapi/api run build

FROM node:22-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app/web-apps

RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

COPY web-apps/package.json web-apps/pnpm-lock.yaml web-apps/pnpm-workspace.yaml ./
COPY web-apps/apps/api/package.json apps/api/package.json

RUN pnpm install --frozen-lockfile --prod --filter @synthapi/api...

COPY --from=builder /repo/web-apps/apps/api/dist apps/api/dist
COPY --from=builder /repo/web-apps/apps/api/migrations apps/api/migrations
COPY --from=builder /repo/web-apps/apps/api/agent_config_migrations apps/api/agent_config_migrations

WORKDIR /app/web-apps/apps/api

EXPOSE 3001

CMD ["node", "dist/src/server.js"]
