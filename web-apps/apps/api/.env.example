# API server local development environment
# Copy this file to .env and fill in secrets

USE_VAULT_SECRETS=false
PORT=3001
CORS_WHITELISTED_DOMAINS=http://localhost:5173,http://127.0.0.1:5173

DB_USER=user
DB_PASS=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mock_api

REDIS_HOST=redis
REDIS_PASSWORD=redis-password
REDIS_PORT=6379

WEB_APP_BASE_URL=http://localhost:8787
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/mock-stack/api/v1/auth/google/callback
MAILERSEND_API_KEY=<MailerSend API token>
MAILERSEND_BASE_URL=https://api.mailersend.com/v1
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
PORTKEY_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
