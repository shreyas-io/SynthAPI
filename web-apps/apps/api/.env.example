# API server local development environment
# Copy this file to .env and fill in secrets

USE_VAULT_SECRETS=false
PORT=3001
CORS_WHITELISTED_DOMAINS=http://localhost:8787,https://synthapi.pages.dev

DB_USER=user
DB_PASS=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mock_api

REDIS_URL=redis://:redis-password@redis:6379

WEB_APP_BASE_URL=http://localhost:8787/platform
MOCK_API_BASE_URL_TEMPLATE=http://{projectSlug}.mock.localhost:8787
COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/v1/auth/google/callback
MAILERSEND_API_KEY=<MailerSend API token>
MAILERSEND_BASE_URL=https://api.mailersend.com/v1
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
PORTKEY_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
TAVILY_API_KEY=
SENTRY_DSN=
