FROM node:22-alpine

WORKDIR /repo/web-apps

RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

COPY web-apps/package.json web-apps/pnpm-lock.yaml web-apps/pnpm-workspace.yaml web-apps/tsconfig.base.json ./
COPY web-apps/apps/api/package.json apps/api/package.json
COPY web-apps/apps/web/package.json apps/web/package.json

RUN pnpm install --frozen-lockfile --filter @mock-stack/api...

EXPOSE 3001 9229

CMD ["pnpm", "--filter", "@mock-stack/api", "run", "dev"]
