{
  "name": "@mock-stack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --inspect=0.0.0.0:9229 --watch --import tsx --enable-source-maps src/server.ts",
    "build": "pnpm --filter @mock-stack/agent-orchestration-engine run build && pnpm --filter @mock-stack/mockapi-engine run build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:latest": "tsx src/infrastructure/kysely/migrator.ts latest",
    "migrate:down": "tsx src/infrastructure/kysely/migrator.ts down",
    "seed:local": "tsx src/infrastructure/kysely/seed_local.ts",
    "docker:build": "docker build -f Dockerfile -t mock-stack-api ../.."
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "@mock-stack/agent-orchestration-engine": "workspace:*",
    "@mock-stack/mockapi-engine": "workspace:*",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "kysely": "^0.28.16",
    "pg": "^8.20.0",
    "redis": "^5.10.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
