    "ai": "^6.0.0",
    "ai-gateway-provider": "^3.0.0",
    "ajv": "^8.20.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "kysely": "^0.28.16",
    "lodash": "^4.18.1",
    "pg": "^8.20.0",
