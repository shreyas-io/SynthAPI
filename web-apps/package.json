{
  "name": "mock-stack",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "pnpm --filter @mock-stack/agent-orchestration-engine run build && pnpm --parallel --stream --filter @mock-stack/agent-orchestration-engine --filter @mock-stack/api --filter @mock-stack/web run \"/^dev$|^build:watch$/\"",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "deploy:web": "pnpm --filter @mock-stack/web run deploy"
  }
}
