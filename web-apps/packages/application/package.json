{
  "name": "@mock-stack/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:create": "tsx src/create_migration.ts",
    "migrate:latest": "tsx src/migrator.ts latest",
    "migrate:down": "tsx src/migrator.ts down",
    "pyodide:smoke": "tsx src/infrastructure/pyodide/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/lodash": "^4.17.24",
    "ajv": "^8.20.0",
    "kysely": "^0.28.8",
    "lodash": "^4.18.1",
    "pg": "^8.16.3",
    "pyodide": "^0.29.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.2"
  }
}
